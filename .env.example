# Copy to .env.local and fill in.

# Google Analytics 4 measurement ID (starts with G-). Leave empty to disable GA.
NEXT_PUBLIC_GA_ID=

# Canonical site URL used for SEO metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://shipandshout.com

# --- Contact form email delivery (Resend) ---------------------------------
# API key from https://resend.com/api-keys (starts with re_). Server-only — never NEXT_PUBLIC_.
# Without it: dev logs submissions to the console; production returns 500 so leads aren't lost silently.
RESEND_API_KEY=

# Where inquiries land. Defaults to `site.email` in src/config/site.ts when empty.
CONTACT_TO_EMAIL=

# Sender shown on the inquiry email. Defaults to "Ship & Shout <onboarding@resend.dev>", which
# only delivers to the Resend account owner's address. After verifying shipandshout.com in
# Resend (Domains → Add → DNS records), switch to your own domain, e.g.:
# CONTACT_FROM_EMAIL="Ship & Shout <leads@shipandshout.com>"
CONTACT_FROM_EMAIL=
